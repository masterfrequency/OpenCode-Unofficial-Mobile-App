# Android / Gradle
.gradle/
build/
local.properties
*.keystore
*.jks
keystore.properties
release-key.jks

# Build output is ignored by default. The signed release artifacts under
# releases/<version>/ ARE tracked on purpose so they are downloadable straight
# from the repository. Un-ignore those explicitly.
*.apk
*.aab
!releases/**/*.apk
!releases/**/*.aab

# Gateway runtime state - never commit these
.devices.json
.pairing-code
*.token
opencode-unofficial-token.txt

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# OS
node_modules/

# Staging scratch directory, not tracked. Signed artifacts are committed
# under releases/<version>/ instead.
dist/
