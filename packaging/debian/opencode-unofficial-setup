#!/bin/sh
set -eu

for command in opencode node tailscale systemctl; do
  command -v "$command" >/dev/null 2>&1 || { echo "Missing requirement: $command" >&2; exit 1; }
done

install_dir="${XDG_DATA_HOME:-$HOME/.local/share}/opencode-unofficial-gateway"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode-unofficial"
service_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$install_dir" "$config_dir" "$service_dir"
cp -R /usr/lib/opencode-unofficial-gateway/. "$install_dir/"
chmod 700 "$install_dir"
chmod +x "$install_dir/start.sh"

env_file="$config_dir/gateway.env"
if [ ! -f "$env_file" ]; then
  if command -v openssl >/dev/null 2>&1; then token=$(openssl rand -hex 32)
  else token=$(node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))")
  fi
  printf 'OPENCODE_REMOTE_TOKEN=%s\n' "$token" > "$env_file"
  chmod 600 "$env_file"
fi

cat > "$service_dir/opencode-unofficial-gateway.service" <<EOF
[Unit]
Description=OpenCode Unofficial Gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$install_dir
EnvironmentFile=$env_file
ExecStart=$install_dir/start.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable --now opencode-unofficial-gateway.service
tailscale serve --bg localhost:4174
i=0
while [ ! -f "$install_dir/.pairing-code" ] && [ "$i" -lt 40 ]; do sleep 0.25; i=$((i + 1)); done
echo ""
echo "Gateway installed in: $install_dir"
if [ -f "$install_dir/.pairing-code" ]; then echo "Pairing code: $(cat "$install_dir/.pairing-code")"; fi
echo "Use the HTTPS URL shown by 'tailscale serve status' in the Android app."
