<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_label"
        android:textColor="#22E8F2"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/widget_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#F4F5FB"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#A8ACC3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_new"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:minWidth="88dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/widget_new_chat"
        android:textColor="#05060B"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/widget_button_bg" />
</LinearLayout>
